{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Nuvio TR HD kişisel katalog v1",
  "type": "object",
  "required": ["version", "items"],
  "properties": {
    "version": { "const": 1 },
    "items": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "allOf": [{ "$ref": "#/$defs/identity" }],
        "required": ["streams"],
        "properties": {
          "streams": {
            "type": "array",
            "minItems": 1,
            "maxItems": 16,
            "items": {
              "type": "object",
              "required": ["url"],
              "properties": {
                "url": { "type": "string", "minLength": 1 },
                "name": { "type": "string" },
                "headers": { "$ref": "#/$defs/headers" },
                "subtitles": { "$ref": "#/$defs/subtitles" }
              }
            }
          },
          "subtitles": { "$ref": "#/$defs/subtitles" }
        }
      }
    }
  },
  "$defs": {
    "headers": { "type": "object", "maxProperties": 30, "additionalProperties": { "type": "string", "maxLength": 4096 } },
    "identity": {
      "type": "object",
      "required": ["tmdbId", "type", "originalTitle", "year"],
      "properties": {
        "tmdbId": { "type": "integer", "minimum": 1 },
        "type": { "enum": ["movie", "tv"] },
        "originalTitle": { "type": "string", "minLength": 1 },
        "year": { "type": "integer", "minimum": 1888, "maximum": 2200 },
        "season": { "type": "integer", "minimum": 1 },
        "episode": { "type": "integer", "minimum": 1 }
      },
      "if": { "properties": { "type": { "const": "tv" } } },
      "then": { "required": ["season", "episode"] }
    },
    "subtitles": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "required": ["url"],
        "anyOf": [{ "required": ["language"] }, { "required": ["lang"] }],
        "properties": {
          "url": { "type": "string", "minLength": 1 },
          "language": { "type": "string" },
          "lang": { "type": "string" },
          "headers": { "$ref": "#/$defs/headers" },
          "identity": { "$ref": "#/$defs/identity" }
        }
      }
    }
  }
}
